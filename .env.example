# Optional. The Canadian pipeline runs without any credentials; FIRMS adds the
# near-real-time and non-Canadian legs. Free key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Identify yourself to the public services you are hitting.
WILDFIRE_USER_AGENT=wildfire-forecast/0.1 (research; you@example.com)

# Optional: move the data directory off the repo.
# WILDFIRE_DATA_DIR=D:/wildfire-data
